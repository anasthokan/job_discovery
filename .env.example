# Copy to `.env` on the RDP/IIS server and fill real values.
# Never commit `.env`.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=job_discovery

# Twice-daily scrape (Asia/Kolkata = IST). Hours are comma-separated.
# Leave SCRAPE_KEYWORDS empty to pull all job fields. A comma list matches ANY keyword (OR).
SCRAPE_SCHEDULE_ENABLED=true
SCRAPE_TZ=Asia/Kolkata
SCRAPE_HOURS=8,20
SCRAPE_KEYWORDS=
SCRAPE_STATE=All
SCRAPE_PLATFORM=All
SCRAPE_CITY=
