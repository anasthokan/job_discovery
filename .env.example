# Copy to `.env` on the RDP/IIS server and fill real values.
# Never commit `.env`.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=ezyjob

# Twice-daily scrape (Asia/Kolkata = IST). Hours are comma-separated.
# Leave SCRAPE_KEYWORDS empty to pull all job fields. A comma list matches ANY keyword (OR).
SCRAPE_SCHEDULE_ENABLED=true
SCRAPE_TZ=Asia/Kolkata
SCRAPE_HOURS=8,20
SCRAPE_KEYWORDS=
SCRAPE_STATE=All
SCRAPE_PLATFORM=All
SCRAPE_CITY=

# E-Verify: export employer table from https://www.e-verify.gov/e-verify-employer-search
# (Download → Crosstab/Data) and save as this CSV, then POST /api/everify/refresh
EVERIFY_CSV=data/everify_employers.csv

# Optional keyed aggregators. Leave blank to skip that source during scrape.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=
CAREERJET_AFFID=
CAREERJET_USER_IP=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
